{
  "manifest_version": 3,
  "name": "Feature Flag Toggler",
  "version": "1.0.0",
  "description": "Toggle feature flags on demo pages via a draggable in-page panel.",
  "permissions": ["storage", "activeTab"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_title": "Toggle Feature Flag Panel",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["bridge.js"],
      "run_at": "document_start",
      "world": "ISOLATED"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["flags.js", "injected.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ]
}
